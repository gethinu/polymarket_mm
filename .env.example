# Polymarket MM / CLOB credentials — copy to `.env` (gitignored) and fill values.
# NEVER commit real secrets. Loaded at startup by scripts/lib/env_bootstrap.py
# (non-override: an already-set process/User env var wins over these).
#
# Canonical names below are what the code reads (lib/clob_auth.py). Any alias in
# parentheses is also accepted and mapped to the canonical name automatically.

# EOA private key: 64 hex chars, optional 0x prefix.
#   aliases: POLYMARKET_PRIVATE_KEY, POLY_PRIVATE_KEY, CLOB_PRIVATE_KEY, PRIVATE_KEY
PM_PRIVATE_KEY=

# Funder / proxy address: 0x + 40 hex.
#   aliases: PM_PROXY_ADDRESS, POLYMARKET_FUNDER, POLY_FUNDER, FUNDER, PROXY_ADDRESS
PM_FUNDER=

# Signature type for your account (0/1/2).
PM_SIGNATURE_TYPE=2

# Optional: pre-derived L2 API creds (otherwise derived from the key at startup).
# PM_API_KEY=
# PM_API_SECRET=
# PM_API_PASSPHRASE=

# Alternative to an inline key (either works; env_bootstrap/clob_auth read these too):
#   PM_PRIVATE_KEY_FILE=          # path to a plaintext file holding the hex key
#   PM_PRIVATE_KEY_DPAPI_FILE=    # path to a PowerShell ConvertFrom-SecureString (DPAPI) file

# Point at a .env kept outside the repo (file or directory):
#   POLYMARKET_MM_ENV_FILE=C:\path\to\your\.env

# SAFETY: live-execution keys are IGNORED if placed here. A .env can never enable
# live trading. Any key whose name contains EXECUTE or CONFIRM_LIVE is refused:
#   CLOBBOT_EXECUTE / CLOBMM_EXECUTE / *_CONFIRM_LIVE  -> not loaded from .env.
